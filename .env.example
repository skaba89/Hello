# ══════════════════════════════════════════════════════════════════
# .env.example – Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer le fichier .env dans git
# ══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────
POSTGRES_USER=automation
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=automation_db

# ─────────────────────────────────────
# Redis
# ─────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ─────────────────────────────────────
# n8n
# ─────────────────────────────────────
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http

# URL publique (pour les webhooks entrants – utilisez ngrok en local)
N8N_WEBHOOK_URL=https://YOUR_NGROK_OR_DOMAIN.ngrok.io/
N8N_EDITOR_BASE_URL=http://localhost:5678/

# Auth interface n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password_here

# Clé de chiffrement n8n (32 caractères aléatoires)
# Générer avec : openssl rand -hex 16
N8N_ENCRYPTION_KEY=CHANGE_ME_32chars_encryption_key_here

N8N_LOG_LEVEL=info
TIMEZONE=Europe/Paris

# ─────────────────────────────────────
# Claude API (Anthropic)
# ─────────────────────────────────────
CLAUDE_API_KEY=sk-ant-CHANGE_ME_your_claude_api_key

# ─────────────────────────────────────
# Playwright Server
# ─────────────────────────────────────
# Clé API locale pour sécuriser les appels n8n → playwright-server
# Générer avec : openssl rand -hex 24
PLAYWRIGHT_SERVER_API_KEY=CHANGE_ME_playwright_local_api_key

PLAYWRIGHT_HEADLESS=true

# ─────────────────────────────────────
# Comptes LinkedIn
# ─────────────────────────────────────
LINKEDIN_EMAIL=your_linkedin@email.com
LINKEDIN_PASSWORD=CHANGE_ME_linkedin_password

# Limites anti-ban LinkedIn
LINKEDIN_DAILY_INVITE_LIMIT=60        # Max recommandé : 60-80/jour
LINKEDIN_MIN_DELAY_MS=45000           # 45 secondes minimum entre actions
LINKEDIN_MAX_DELAY_MS=90000           # 90 secondes maximum

# ─────────────────────────────────────
# Comptes Instagram
# ─────────────────────────────────────
INSTAGRAM_EMAIL=your_instagram@email.com
INSTAGRAM_PASSWORD=CHANGE_ME_instagram_password

# Limites anti-ban Instagram
INSTAGRAM_DAILY_DM_LIMIT=30
INSTAGRAM_MIN_DELAY_MS=30000

# ─────────────────────────────────────
# Notifications Discord / Slack
# ─────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ─────────────────────────────────────
# Mode dry-run (true = ne rien envoyer, juste logger)
# ─────────────────────────────────────
DRY_RUN=false

# ─────────────────────────────────────
# Logs
# ─────────────────────────────────────
LOG_LEVEL=info
